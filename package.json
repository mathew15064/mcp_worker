{
  "name": "mcp_worker",
  "version": "2.0.0",
  "private": true,
  "description": "Deterministic MCP coding execution harness with outbound worker and SSH compatibility transports",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "init-db": "node dist/scripts/init-db.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:e2e": "npm run build && playwright test --config dist/playwright.config.js",
    "backup-db": "node dist/scripts/backup-db.js",
    "rotate-admin-password": "node dist/scripts/rotate-admin-password.js",
    "terminal-profile": "node dist/scripts/terminal-profile.js",
    "mcp-client": "node dist/scripts/mcp-client.js",
    "worker": "npm run build && node dist/worker/agent.js",
    "migrate": "node dist/scripts/migrate.js migrate",
    "migrate:status": "node dist/scripts/migrate.js status",
    "migrate:rollback": "node dist/scripts/migrate.js rollback",
    "migrate:reset": "node dist/scripts/migrate.js reset",
    "migrate:fresh": "node dist/scripts/migrate.js fresh",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "first:mcp": "npm run build && node dist/scripts/first-mcp-call.js",
    "lint": "node scripts/lint-typescript.cjs",
    "lint:typed": "eslint \"src/**/*.ts\" \"worker/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"worker/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" playwright.config.ts",
    "format:write": "prettier --write \"src/**/*.ts\" \"worker/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" playwright.config.ts",
    "quality:check": "node scripts/quality-gate.mjs check",
    "quality:baseline": "node scripts/quality-gate.mjs record"
  },
  "keywords": [
    "mcp",
    "worker",
    "ssh",
    "coding-harness",
    "mysql"
  ],
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6",
    "ssh2": "1.16.0",
    "ws": "8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/mime-types": "2.1.4",
    "@types/node": "26.6.6",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
