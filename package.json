{
  "name": "mcp_worker",
  "version": "3.0.0",
  "private": true,
  "description": "Deterministic MCP coding execution harness with outbound Worker-only execution",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "init-db": "node dist/scripts/init-bundled-db.js --init-fresh",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:e2e": "npm run build && playwright test --config dist/playwright.config.js",
    "backup-db": "node dist/scripts/backup-db.js",
    "rotate-admin-password": "node dist/scripts/rotate-admin-password.js",
    "mcp-client": "node dist/scripts/mcp-client.js",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "first:mcp": "npm run build && node dist/scripts/first-mcp-call.js",
    "lint": "node scripts/lint-typescript.cjs",
    "lint:typed": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" playwright.config.ts",
    "format:write": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" playwright.config.ts"
  },
  "keywords": [
    "mcp",
    "worker",
    "coding-harness",
    "sqlite"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "express-session": "^1.19.0",
    "ws": "8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": "22.x"
  }
}
