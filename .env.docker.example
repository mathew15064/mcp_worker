# Bot Report production bootstrap configuration
BOT_REPORT_EXTERNAL_NETWORK=

PORT=80
HOST=0.0.0.0
NODE_ENV=production

# Transitional source only. Existing installations may keep the old SQLite file
# here so Settings -> Database can import it once into MySQL.
DATABASE_PATH=/app/data/bot_report.sqlite

# Administrator authentication remains independent from the application database.
SESSION_SECRET=
COOKIE_SECURE=true
TRUST_PROXY=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
ADMIN_SESSION_MAX=500

# Root application encryption key for MySQL bootstrap password, Terminal passwords,
# and new Telegram token envelopes. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Existing installations can keep this during migration. If APP_ENCRYPTION_KEY is
# omitted, Bot Report falls back to TERMINAL_CREDENTIAL_KEY so existing encrypted
# Terminal/Telegram credentials remain readable.
TERMINAL_CREDENTIAL_KEY=
TELEGRAM_CREDENTIAL_KEY=

# MySQL connection, MCP behavior and Telegram operational settings are configured
# from /admin/settings and are intentionally not required here.
