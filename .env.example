# mcp_worker development bootstrap configuration
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Transitional legacy SQLite source. Fresh installs do not need this file to exist.
DATABASE_PATH=./data/bot_report.sqlite

# Administrator auth is intentionally independent from the application database.
SESSION_SECRET=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<CONFIGURE_STRONG_ADMIN_PASSWORD>
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
ADMIN_SESSION_MAX=500
TRUST_PROXY=false
COOKIE_SECURE=false

# Root AES-256-GCM application key. Must decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Existing installs may keep this during migration; it is a fallback only.
TERMINAL_CREDENTIAL_KEY=
TELEGRAM_CREDENTIAL_KEY=

# MySQL, MCP and Telegram operational settings are configured from /admin/settings.
